{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentBusConnectorManifest",
  "type": "object",
  "required": [
    "schema_version",
    "connector_id",
    "connector_version",
    "protocol_version",
    "display_name",
    "products",
    "entry_kind",
    "execution_surface",
    "transport",
    "declared_capabilities"
  ],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "connector_id": { "type": "string", "pattern": "^[a-z0-9_\\-\\.]+$" },
    "connector_version": { "type": "string" },
    "protocol_version": { "type": "string", "enum": ["agentbus-trigger/1"] },
    "display_name": { "type": "string" },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["product_id", "vendor"],
        "properties": {
          "product_id": { "type": "string" },
          "vendor": { "type": "string" },
          "channels": { "type": "array", "items": { "type": "string" } },
          "os": { "type": "array", "items": { "type": "string" } },
          "min_version": { "type": "string" }
        }
      }
    },
    "entry_kind": {
      "type": "string",
      "enum": ["host_bridge", "extension", "hook", "sidecar", "session_client", "manual"]
    },
    "execution_surface": {
      "type": "string",
      "enum": ["desktop_existing", "restored_session", "independent_process", "manual"]
    },
    "transport": {
      "type": "string",
      "enum": ["in_host", "local_pipe", "file_channel", "official_http"]
    },
    "declared_capabilities": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    }
  }
}
